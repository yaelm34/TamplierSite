---
import { Image } from 'astro:assets';
import { site, legal, getContent } from '../data/content';
import logoFull from '../assets/images/logo-full.png';
const { nav, ui } = getContent(Astro.currentLocale);
const base = Astro.currentLocale === 'en' ? '/en' : '';
const year = new Date().getFullYear();
---

<footer class="on-dark relative overflow-hidden bg-racing-deep text-ivory">
  <span class="gold-rule absolute inset-x-0 top-0"></span>
  <div class="mx-auto w-full max-w-[1440px] px-6 py-12 sm:px-10 lg:px-14 lg:py-14">
    <div class="grid gap-10 lg:grid-cols-[1.4fr_1fr_1fr]">
      <div>
        <Image
          src={logoFull}
          alt={site.name}
          widths={[220, 340, 460]}
          sizes="200px"
          class="h-auto w-40 sm:w-44"
          style="filter: brightness(0) invert(1); opacity:.95"
        />
        <p class="muted mt-6 max-w-[38ch] text-sm">
          {ui.footerDesc}
        </p>
      </div>

      <nav aria-label={ui.navSecondary}>
        <h2 class="eyebrow mb-5">{ui.footerNav}</h2>
        <ul class="space-y-3">
          {nav.map((item) => (
            <li>
              <a class="muted text-sm transition-colors hover:text-gold" href={item.href}>{item.label}</a>
            </li>
          ))}
          <li><a class="muted text-sm transition-colors hover:text-gold" href={`${base}/mentions-legales`}>{ui.footerLegal}</a></li>
          <li><a class="muted text-sm transition-colors hover:text-gold" href={`${base}/politique-de-confidentialite`}>{ui.footerPrivacy}</a></li>
        </ul>
      </nav>

      <div>
        <h2 class="eyebrow mb-5">{ui.footerContact}</h2>
        <ul class="space-y-3 text-sm">
          <li><a class="muted transition-colors hover:text-gold" href={`tel:${site.phoneIntl}`}>{site.phone}</a></li>
          <li><a class="muted break-all transition-colors hover:text-gold" href={`mailto:${site.email}`}>{site.email}</a></li>
          <li class="muted">{site.address.street}<br />{site.address.postalCode} {site.address.locality}</li>
        </ul>
      </div>
    </div>

    <div class="gold-rule my-8 opacity-40"></div>

    <p class="muted-soft max-w-[95ch] text-[0.6875rem] leading-relaxed">{legal.companyLine}</p>
    <p class="muted-soft mt-4 text-[0.6875rem]">© {year} {site.name}. {ui.footerRights}</p>
  </div>
</footer>
