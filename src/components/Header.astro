---
import { Image } from 'astro:assets';
import Button from './Button.astro';
import { getContent, site } from '../data/content';
import wordmark from '../assets/images/logo-full.png';

const { nav, cta, ui } = getContent(Astro.currentLocale);
const cur = Astro.currentLocale === 'en' ? 'en' : 'fr';
// URL de la même page dans l'autre langue (FR ⇄ EN).
const path = Astro.url.pathname;
const altHref =
  cur === 'en' ? path.replace(/^\/en(\/|$)/, '/') : path === '/' ? '/en/' : `/en${path}`;
const altLang = cur === 'en' ? 'fr' : 'en';
---

<header
  data-header
  data-scrolled="false"
  data-hidden="false"
  class="fixed inset-x-0 top-0 z-50 transition-[background-color,backdrop-filter,border-color,transform] duration-500 ease-[var(--ease-lux)]
         data-[scrolled=true]:bg-paper/85 data-[scrolled=true]:backdrop-blur-xl
         data-[hidden=true]:-translate-y-full
         border-b border-transparent data-[scrolled=true]:border-racing/10"
>
  <div class="mx-auto flex h-[var(--header-h)] w-full max-w-[1440px] items-center justify-between px-6 sm:px-10 lg:px-14">
    <a href="#top" class="block shrink-0 transition-opacity hover:opacity-70" aria-label={`${site.name} — ${ui.homeAria}`}>
      <Image
        src={wordmark}
        alt={site.name}
        widths={[120, 200, 300]}
        sizes="140px"
        loading="eager"
        class="h-12 w-auto sm:h-14"
      />
    </a>

    <nav class="hidden items-center gap-9 lg:flex" aria-label={ui.navMain}>
      {
        nav.map((item) => (
          <a
            href={item.href}
            class="group relative flex items-center gap-2 text-[0.72rem] font-medium uppercase tracking-[0.18em] text-racing/70 transition-colors duration-300 hover:text-racing"
          >
            {item.label}
            <span class="absolute -bottom-1.5 left-0 h-px w-0 bg-gold-dark transition-all duration-500 ease-[var(--ease-lux)] group-hover:w-full" />
          </a>
        ))
      }
    </nav>

    <div class="hidden items-center gap-5 lg:flex">
      <a
        href={altHref}
        hreflang={altLang}
        aria-label={ui.langLabel}
        class="group flex items-center gap-1.5 text-[0.72rem] font-semibold uppercase tracking-[0.16em] text-racing/65 transition-colors duration-300 hover:text-racing"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" class="h-[1.05rem] w-[1.05rem]" aria-hidden="true">
          <circle cx="12" cy="12" r="9" />
          <path d="M3 12h18" />
          <path d="M12 3c2.6 2.7 2.6 15.3 0 18M12 3c-2.6 2.7-2.6 15.3 0 18" />
        </svg>
        <span>{ui.langCode}</span>
      </a>
      <Button href={cta.primary.href} variant="solid" class="!px-6 !py-3">{cta.primary.label}</Button>
    </div>

    <!-- Mobile: language switch + toggle -->
    <div class="flex items-center gap-1 lg:hidden">
      <a
        href={altHref}
        hreflang={altLang}
        aria-label={ui.langLabel}
        class="flex h-11 items-center gap-1.5 px-2 text-[0.72rem] font-semibold uppercase tracking-[0.16em] text-racing/70"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" class="h-[1.05rem] w-[1.05rem]" aria-hidden="true">
          <circle cx="12" cy="12" r="9" />
          <path d="M3 12h18" />
          <path d="M12 3c2.6 2.7 2.6 15.3 0 18M12 3c-2.6 2.7-2.6 15.3 0 18" />
        </svg>
        <span>{ui.langCode}</span>
      </a>
      <button
        type="button"
        class="relative z-50 flex h-11 w-11 items-center justify-center"
        aria-label={ui.menuOpen}
        data-menu-toggle
        data-label-open={ui.menuOpen}
        data-label-close={ui.menuClose}
      >
        <span class="menu-bars relative block h-3 w-6">
          <span class="menu-bar absolute left-0 top-0 h-px w-full bg-racing transition-all duration-400 ease-[var(--ease-lux)]"></span>
          <span class="menu-bar absolute bottom-0 left-0 h-px w-full bg-racing transition-all duration-400 ease-[var(--ease-lux)]"></span>
        </span>
      </button>
    </div>
  </div>
</header>

<!-- Full-screen mobile overlay (dark, dramatic) -->
<div
  data-menu-panel
  class="on-dark fixed inset-0 z-40 flex translate-y-[-100%] flex-col justify-center bg-racing-deep px-8 opacity-0 transition-[transform,opacity] duration-700 ease-[var(--ease-lux)] lg:hidden"
  aria-hidden="true"
>
  <span class="glow-follow" aria-hidden="true"></span>
  <nav class="relative flex flex-col gap-2" aria-label={ui.navMobile}>
    {
      nav.map((item) => (
        <a
          href={item.href}
          class="flex items-baseline gap-4 border-b border-ivory/10 py-5 font-serif text-4xl font-light text-ivory"
        >
          {item.label}
        </a>
      ))
    }
  </nav>
  <div class="relative mt-12 flex items-center justify-between gap-5">
    <Button href={cta.primary.href} variant="solid" magnetic={false}>{cta.primary.label}</Button>
    <a
      href={altHref}
      hreflang={altLang}
      aria-label={ui.langLabel}
      class="flex shrink-0 items-center gap-2 text-[0.78rem] font-semibold uppercase tracking-[0.16em] text-ivory/75 transition-colors hover:text-gold"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" class="h-5 w-5" aria-hidden="true">
        <circle cx="12" cy="12" r="9" />
        <path d="M3 12h18" />
        <path d="M12 3c2.6 2.7 2.6 15.3 0 18M12 3c-2.6 2.7-2.6 15.3 0 18" />
      </svg>
      <span>{ui.langCode}</span>
    </a>
  </div>
</div>

<style is:global>
  [data-menu-open] [data-menu-panel] {
    transform: translateY(0) !important;
    opacity: 1 !important;
  }
  [data-menu-open] .menu-bar {
    background: var(--color-ivory);
  }
  [data-menu-open] .menu-bars .menu-bar:first-child {
    transform: translateY(6px) rotate(45deg);
  }
  [data-menu-open] .menu-bars .menu-bar:last-child {
    transform: translateY(-5px) rotate(-45deg);
  }
  [data-menu-open] {
    overflow: hidden;
  }
  /* header never retires while the menu is open */
  [data-menu-open] [data-header] {
    transform: none !important;
  }
</style>

<script>
  const toggle = document.querySelector('[data-menu-toggle]');
  const root = document.documentElement;
  const labelOpen = toggle?.getAttribute('data-label-open') || 'Open menu';
  const labelClose = toggle?.getAttribute('data-label-close') || 'Close menu';
  toggle?.addEventListener('click', () => {
    const open = root.hasAttribute('data-menu-open');
    if (open) root.removeAttribute('data-menu-open');
    else root.setAttribute('data-menu-open', '');
    toggle.setAttribute('aria-label', open ? labelOpen : labelClose);
  });
</script>
