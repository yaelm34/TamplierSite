---
import Base from '../layouts/Base.astro';
import SplitText from './SplitText.astro';
interface Props {
  title: string;
  eyebrow: string;
  metaTitle: string;
  description: string;
}
const { title, eyebrow, metaTitle, description } = Astro.props;
---
<Base title={metaTitle} description={description} preload={false}>
  <article class="relative overflow-hidden bg-paper pt-[calc(var(--header-h)+5rem)] pb-32 text-racing">
    <div class="mx-auto w-full max-w-[820px] px-6 sm:px-10">
      <div class="mb-6 flex items-center gap-4">
        <span class="h-px w-10 bg-gold-dark/50"></span>
        <span class="eyebrow">{eyebrow}</span>
      </div>
      <SplitText lines={[title]} class="headline" as="h1" />
      <span class="gold-rule mt-12 mb-14 block"></span>
      <div class="legal-prose prose-lux">
        <slot />
      </div>
      <a href="/" class="mt-16 inline-flex items-center gap-3 text-[0.72rem] uppercase tracking-[0.22em] text-gold-dark transition-colors hover:text-racing">
        <span>←</span> Retour à l'accueil
      </a>
    </div>
  </article>
</Base>

<style is:global>
  .legal-prose h2 {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: 1.7rem;
    color: var(--color-racing);
    margin-top: 2.6rem;
    margin-bottom: 0.9rem;
    letter-spacing: -0.01em;
  }
  .legal-prose h2:first-child {
    margin-top: 0;
  }
  .legal-prose p,
  .legal-prose li {
    color: color-mix(in srgb, var(--color-racing) 72%, transparent);
    line-height: 1.75;
  }
  .legal-prose p {
    margin-bottom: 1rem;
  }
  .legal-prose ul {
    list-style: none;
    padding-left: 0;
    margin-bottom: 1rem;
  }
  .legal-prose li {
    position: relative;
    padding-left: 1.4rem;
    margin-bottom: 0.5rem;
  }
  .legal-prose li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.7em;
    width: 5px;
    height: 5px;
    transform: rotate(45deg);
    background: var(--color-gold-dark);
  }
  .legal-prose a {
    color: var(--color-gold-dark);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .legal-prose strong {
    color: var(--color-racing);
    font-weight: 600;
  }
</style>
