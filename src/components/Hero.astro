---
import { Image } from 'astro:assets';
import Button from './Button.astro';
import Marquee from './Marquee.astro';
import { getContent } from '../data/content';
import banner from '../assets/images/banner.png';

const { hero, cta, ui } = getContent(Astro.currentLocale);
const words = (s: string) => s.split(' ');
---

<section
  data-hero
  class="relative flex min-h-[100svh] flex-col overflow-hidden bg-paper pt-[var(--header-h)]"
>
  <!-- Car: right side, bleeding off the edge, melting into the paper -->
  <div class="pointer-events-none absolute inset-y-0 right-0 z-0 hidden w-[54%] lg:block">
    <div data-hero-media class="absolute inset-0 flex items-center justify-center px-[2vw]">
      <Image
        src={banner}
        alt={ui.heroBannerAlt}
        widths={[768, 1200, 1600, 2000]}
        sizes="54vw"
        format="webp"
        loading="eager"
        fetchpriority="high"
        class="mx-auto h-auto w-[88%] object-contain"
      />
    </div>
    <!-- soft left fade for the type overlap zone -->
    <div
      class="absolute inset-0"
      style="background: linear-gradient(90deg, var(--color-paper) 0%, color-mix(in srgb, var(--color-paper) 60%, transparent) 20%, transparent 45%);"
      aria-hidden="true"
    ></div>
  </div>

  <!-- Text: left column -->
  <div class="relative z-10 mx-auto flex w-full max-w-[1440px] flex-1 flex-col px-6 sm:px-10 lg:px-14">
    <div class="flex flex-1 flex-col justify-center py-10">
      <div class="mb-8 flex items-center gap-4" data-reveal="rise">
        <span class="h-px w-12 bg-gold-dark/60"></span>
        <span class="eyebrow">{hero.eyebrow}</span>
      </div>

      <h1 class="display max-w-[13ch] text-racing" data-word-reveal>
        {/* L'espace inter-mots vit HORS du masque : à l'intérieur, une espace
            finale « pend » en bout de ligne et ne compte pas dans la largeur,
            ce qui recolle les mots (L'artdusourcing). */}
        <span class="block">
          {words(hero.titleTop).map((w, i, arr) => (
            <>
              <span class="w-mask"><span class="w-inner">{w}</span></span>
              {i < arr.length - 1 ? ' ' : ''}
            </>
          ))}
        </span>
        <span class="block">
          {words(hero.titleAccent).map((w, i, arr) => (
            <>
              <span class="w-mask"><span class="w-inner italic-display text-gold-dark">{w}</span></span>
              {i < arr.length - 1 ? ' ' : ''}
            </>
          ))}
        </span>
      </h1>

      <p class="body-lg muted mt-8 max-w-[42ch]" data-reveal="rise" data-delay="0.5">
        {hero.lead}
      </p>

      <div class="mt-9 flex flex-col gap-3 sm:flex-row" data-reveal="rise" data-delay="0.65">
        <Button href={cta.primary.href} variant="solid">{cta.primary.label}</Button>
        <Button href={cta.secondary.href} variant="outline">{cta.secondary.label}</Button>
      </div>
    </div>

    <!-- Mobile / tablet: car below the text -->
    <div class="relative mb-6 w-full lg:hidden">
      <Image
        src={banner}
        alt=""
        aria-hidden="true"
        widths={[600, 900, 1200]}
        sizes="100vw"
        format="webp"
        class="h-auto w-full object-contain"
      />
    </div>
  </div>

  <!-- Kinetic marquee band -->
  <div class="relative z-10 mt-auto border-y border-racing/10 py-4">
    <Marquee
      items={hero.marquee}
      duration={55}
      class="font-serif text-2xl font-light italic text-racing/80 sm:text-3xl"
    />
  </div>
</section>
