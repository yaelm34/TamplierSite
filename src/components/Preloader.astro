---
// Paper curtain — wordmark tracking-in over a self-drawing gold hairline.
---
<div
  data-preloader
  class="fixed inset-0 z-[100] flex items-center justify-center bg-paper"
  aria-hidden="true"
>
  <div data-preloader-mark class="flex flex-col items-center gap-5">
    <span class="loader-name font-serif text-[1.6rem] font-light tracking-[0.4em] text-racing pl-[0.4em] sm:text-[2rem]">
      TAMPLIER
    </span>
    <span class="relative block h-px w-44 overflow-hidden bg-racing/10">
      <span class="loader-line absolute inset-y-0 left-0 w-full origin-left bg-gold-dark"></span>
    </span>
    <span class="loader-sub eyebrow text-[0.58rem] tracking-[0.5em] pl-[0.5em]">Auto Sourcing</span>
  </div>
</div>

<style>
  .loader-name,
  .loader-sub {
    opacity: 0;
    animation: fadeUp 1s var(--ease-lux) 0.15s forwards;
  }
  .loader-sub {
    animation-delay: 0.45s;
  }
  .loader-line {
    transform: scaleX(0);
    animation: draw 1.4s var(--ease-lux) 0.3s forwards;
  }
  @keyframes draw {
    to {
      transform: scaleX(1);
    }
  }
  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .loader-name,
    .loader-sub {
      animation: none;
      opacity: 1;
    }
    .loader-line {
      animation: none;
      transform: scaleX(1);
    }
  }
</style>
