---
import { Image } from 'astro:assets';
import { partnership } from '../data/content';
import porsche from '../assets/images/porsche.png';
---

<section class="on-dark relative overflow-hidden bg-racing-deep py-24 text-ivory sm:py-32 lg:py-40" data-parallax-scope>
  <span class="glow-follow" aria-hidden="true"></span>
  <span class="gold-rule absolute inset-x-0 top-0"></span>

  <div class="relative z-10 mx-auto grid w-full max-w-[1440px] items-center gap-14 px-6 sm:px-10 lg:grid-cols-[1fr_1.05fr] lg:gap-20 lg:px-14">
    <!-- Text -->
    <div>
      <div class="mb-7 flex items-center gap-4" data-reveal="rise">
        <span class="h-px w-10 bg-gold/60"></span>
        <span class="eyebrow">{partnership.eyebrow}</span>
      </div>

      <h2 class="headline" data-reveal="rise" data-delay="0.05">
        <span class="text-ivory">{partnership.brandA}</span>
        <span class="sweep-loop mx-3 font-light">×</span>
        <span class="text-gold-light">{partnership.brandB}</span>
      </h2>
      <p class="subhead mt-4 font-light text-ivory/80" data-reveal="rise" data-delay="0.1">
        {partnership.title}
      </p>

      <div class="prose-lux mt-9 space-y-5">
        {
          partnership.paragraphs.map((p, i) => (
            <p class="body-lg muted max-w-[54ch]" data-reveal="rise" data-delay={0.15 + i * 0.08}>
              {p}
            </p>
          ))
        }
      </div>

      <p class="mt-9 inline-block border border-gold/30 px-6 py-3 text-sm italic text-gold-light/90" data-reveal="rise" data-delay="0.3">
        {partnership.note}
      </p>
    </div>

    <!-- Framed illustration plate -->
    <div class="relative" data-reveal="rise" data-delay="0.15">
      <div data-img-reveal class="relative aspect-[16/10] w-full overflow-hidden border border-gold/25 bg-paper">
        <div data-parallax="0.06" class="absolute inset-[4%]">
          <Image
            src={porsche}
            alt="Véhicule premium protégé par film PPF, illustration aquarelle"
            widths={[600, 900, 1400]}
            sizes="(max-width: 1024px) 100vw, 50vw"
            class="h-full w-full object-contain"
          />
        </div>
      </div>
      <span class="pointer-events-none absolute -bottom-3 -right-3 h-16 w-16 border-b border-r border-gold/40" aria-hidden="true"></span>
      <span class="pointer-events-none absolute -left-3 -top-3 h-16 w-16 border-l border-t border-gold/40" aria-hidden="true"></span>
    </div>
  </div>
</section>
