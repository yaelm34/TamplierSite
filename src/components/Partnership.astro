---
import { Image } from 'astro:assets';
import { partnership } from '../data/content';
import banner from '../assets/images/banner.jpg';
---

<section class="on-dark relative flex min-h-[90svh] items-center overflow-hidden bg-racing-deep py-28 text-ivory" data-parallax-scope>
  <!-- Parallax background image -->
  <div data-parallax="0.18" class="absolute inset-[-10%] z-0">
    <Image
      src={banner}
      alt="Carrosserie automobile protégée par film PPF, illustration aquarelle"
      widths={[900, 1400, 1920]}
      sizes="100vw"
      class="h-full w-full object-cover"
    />
  </div>
  <!-- Deep green immersive overlay -->
  <div
    class="absolute inset-0 z-[1]"
    style="background: radial-gradient(120% 100% at 50% 50%, color-mix(in srgb, var(--color-racing-deep) 70%, transparent), var(--color-racing-deep) 88%);"
    aria-hidden="true"
  ></div>
  <span class="gold-rule absolute inset-x-0 top-0 z-10"></span>

  <div class="relative z-10 mx-auto w-full max-w-[1360px] px-6 text-center sm:px-10 lg:px-16">
    <div class="mb-7 flex items-center justify-center gap-4" data-reveal="rise">
      <span class="index-num text-gold">({partnership.index})</span>
      <span class="h-px w-10 bg-gold/60"></span>
      <span class="eyebrow">{partnership.eyebrow}</span>
      <span class="h-px w-10 bg-gold/60"></span>
    </div>

    <h2 class="headline mx-auto max-w-[16ch]" data-reveal="rise" data-delay="0.05">
      <span class="text-ivory">{partnership.brandA}</span>
      <span class="sweep-loop mx-3 font-light">×</span>
      <span class="text-gold-light">{partnership.brandB}</span>
    </h2>
    <p class="subhead mt-4 font-light text-ivory/80" data-reveal="rise" data-delay="0.1">
      {partnership.title}
    </p>

    <div class="prose-lux mx-auto mt-9 space-y-5 text-left sm:text-center">
      {
        partnership.paragraphs.map((p, i) => (
          <p class="body-lg muted mx-auto max-w-[62ch]" data-reveal="rise" data-delay={0.15 + i * 0.08}>
            {p}
          </p>
        ))
      }
    </div>

    <p class="mt-10 inline-block border border-gold/30 px-6 py-3 text-sm italic text-gold-light/90" data-reveal="rise" data-delay="0.3">
      {partnership.note}
    </p>
  </div>
</section>
