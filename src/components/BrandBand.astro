---
import Marquee from './Marquee.astro';
import { brands } from '../data/content';
---

<section aria-label="Réseau de constructeurs" class="relative overflow-hidden border-y border-racing/10 bg-paper py-14 sm:py-16">
  <div class="mx-auto mb-8 flex max-w-[1440px] items-center gap-4 px-6 sm:px-10 lg:px-14" data-reveal="rise">
    <span class="h-px w-10 bg-gold-dark/50"></span>
    <span class="eyebrow">Un réseau activé en France &amp; en Europe</span>
  </div>

  <Marquee
    items={brands}
    duration={46}
    separator="—"
    class="font-serif text-[clamp(2rem,5vw,4rem)] font-light leading-none text-racing/85"
  />
  <div class="mt-3">
    <Marquee
      items={brands}
      duration={54}
      reverse
      separator="—"
      class="font-serif text-[clamp(2rem,5vw,4rem)] font-light italic leading-none text-racing/25"
    />
  </div>
</section>
