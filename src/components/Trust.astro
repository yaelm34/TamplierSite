---
import Section from './Section.astro';
import Icon from './Icon.astro';
import { trust } from '../data/content';
---

<Section id="confiance" tone="paper" eyebrow={trust.eyebrow} index={trust.index} title={trust.title}>
  <div class="grid gap-px overflow-hidden border border-racing/10 bg-racing/10 sm:grid-cols-2" data-stagger>
    {
      trust.items.map((item, i) => (
        <div
          data-stagger-item
          class="group relative flex flex-col bg-paper p-8 transition-colors duration-500 hover:bg-paper-2 sm:p-11"
        >
          <div class="mb-7 flex items-center gap-5">
            <span class="index-num text-gold-dark tabular-nums">0{i + 1}</span>
            <span class="flex h-14 w-14 shrink-0 items-center justify-center border border-gold-dark/40 text-racing transition-colors duration-500 group-hover:border-gold-dark">
              <Icon name={item.icon as any} class="h-7 w-7" />
            </span>
            <span class="h-px flex-1 bg-racing/12"></span>
          </div>
          <h3 class="subhead text-racing">{item.title}</h3>
          <p class="prose-lux mt-4 text-sm leading-relaxed text-racing/72">{item.text}</p>
        </div>
      ))
    }
  </div>
</Section>
