---
import { Image } from 'astro:assets';
import SplitText from './SplitText.astro';
import { concept } from '../data/content';
import aston from '../assets/images/aston.png';
---

<section id="concept" class="relative overflow-hidden bg-paper py-24 text-racing sm:py-32 lg:py-40" data-parallax-scope>
  <!-- ghost numeral -->
  <span class="numeral-ghost pointer-events-none absolute -top-6 right-4 select-none text-[26vw] leading-none lg:text-[18rem]" aria-hidden="true">01</span>

  <div class="relative mx-auto w-full max-w-[1440px] px-6 sm:px-10 lg:px-14">
    <div class="mb-7 flex items-center gap-4" data-reveal="rise">
      <span class="index-num text-gold-dark">({concept.index})</span>
      <span class="h-px w-10 bg-gold-dark/50"></span>
      <span class="eyebrow">{concept.eyebrow}</span>
    </div>

    <div class="grid items-end gap-12 lg:grid-cols-[1.1fr_0.9fr] lg:gap-16">
      <SplitText lines={[concept.title]} class="headline max-w-[10ch]" />
      <p class="font-serif text-[clamp(1.5rem,2.4vw,2.1rem)] font-light italic leading-tight text-gold-dark" data-reveal="rise" data-delay="0.1">
        {concept.lead}
      </p>
    </div>

    <div class="mt-16 grid items-center gap-14 lg:mt-20 lg:grid-cols-[0.85fr_1.15fr] lg:gap-20">
      <!-- text + stats -->
      <div>
        <div class="prose-lux space-y-5">
          {concept.paragraphs.map((p, i) => (
            <p class="body-lg muted" data-reveal="rise" data-delay={0.1 + i * 0.1}>{p}</p>
          ))}
        </div>

        <div class="hair-rule my-10"></div>

        <dl class="grid grid-cols-3 gap-6" data-stagger>
          {concept.stats.map((s) => (
            <div data-stagger-item>
              <dd class="font-serif text-4xl font-light text-racing sm:text-5xl">
                <span data-count={s.value} data-suffix={s.suffix}>0{s.suffix}</span>
              </dd>
              <dt class="muted-soft mt-2 text-[0.7rem] uppercase tracking-[0.16em]">{s.label}</dt>
            </div>
          ))}
        </dl>
      </div>

      <!-- image: floats via multiply, clip reveal + parallax -->
      <div class="relative">
        <div data-img-reveal class="relative aspect-[7/5] w-full overflow-hidden">
          <div data-parallax="0.1" class="absolute inset-[-6%]">
            <Image
              src={aston}
              alt="Aston Martin DB de profil, illustration aquarelle premium"
              widths={[600, 900, 1200, 1408]}
              sizes="(max-width: 1024px) 100vw, 55vw"
              class="h-full w-full object-contain mix-blend-multiply"
            />
          </div>
        </div>
        <span class="index-num absolute -bottom-2 left-0 text-gold-dark" aria-hidden="true">Aston Martin — profil</span>
      </div>
    </div>
  </div>
</section>
