---
import { Image } from 'astro:assets';
import SplitText from './SplitText.astro';
import { getContent } from '../data/content';
import aston from '../assets/images/aston.png';
const { concept, ui } = getContent(Astro.currentLocale);
---

<section id="concept" class="relative overflow-hidden bg-paper py-24 text-racing sm:py-32 lg:py-40" data-parallax-scope>
  <div class="relative mx-auto w-full max-w-[1440px] px-6 sm:px-10 lg:px-14">
    <div class="mb-7 flex items-center gap-4" data-reveal="rise">
      <span class="h-px w-10 bg-gold-dark/50"></span>
      <span class="eyebrow">{concept.eyebrow}</span>
    </div>

    <div class="grid items-end gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:gap-16">
      <SplitText lines={[concept.title]} class="headline max-w-[10ch]" />
      <p class="font-serif text-[clamp(1.4rem,2.2vw,2rem)] font-light italic leading-snug text-gold-dark lg:pb-2" data-reveal="rise" data-delay="0.1">
        {concept.lead}
      </p>
    </div>

    <!-- The artwork — détourée (PNG transparent), cadre ajusté au ratio de la voiture
         pour éviter les grands vides ; largeur limitée pour garder une taille mesurée. -->
    <div class="mx-auto mt-10 max-w-[920px] lg:mt-12">
      <div data-img-reveal class="relative aspect-[14/5] w-full overflow-hidden">
        <div class="absolute inset-0">
          <Image
            src={aston}
            alt={ui.conceptArtAlt}
            widths={[700, 920, 1400]}
            sizes="(max-width: 920px) 100vw, 920px"
            format="png"
            class="h-full w-full object-contain"
          />
        </div>
      </div>
      <div class="mt-1 flex items-center justify-between border-t border-racing/10 pt-4">
        <span class="caption muted-soft">{ui.conceptCaption}</span>
        <span class="caption text-gold-dark">{ui.region}</span>
      </div>
    </div>

    <!-- Copy + figures -->
    <div class="mt-16 grid gap-12 lg:mt-20 lg:grid-cols-[1.1fr_0.9fr] lg:gap-24">
      <div class="prose-lux space-y-5">
        {concept.paragraphs.map((p, i) => (
          <p class="body-lg muted" data-reveal="rise" data-delay={0.05 + i * 0.1}>{p}</p>
        ))}
      </div>

      <dl class="flex flex-col justify-end gap-7" data-stagger>
        {concept.stats.map((s) => (
          <div class="flex items-baseline justify-between border-b border-racing/10 pb-5" data-stagger-item>
            <dt class="muted-soft text-[0.7rem] uppercase tracking-[0.16em]">{s.label}</dt>
            <dd class="font-serif text-4xl font-light text-racing sm:text-5xl">
              <span data-count={s.value} data-suffix={s.suffix}>0{s.suffix}</span>
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>
