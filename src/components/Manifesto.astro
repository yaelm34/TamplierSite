---
import { manifesto } from '../data/content';

// split into words, tagging the gold key words (punctuation-insensitive)
const isGold = (w: string) =>
  manifesto.goldWords.some((g) => w.toLowerCase().replace(/[.,;:!?]/g, '') === g);
const words = manifesto.text.split(' ');
---

<section class="on-dark relative overflow-hidden bg-racing-deep py-28 text-ivory sm:py-36 lg:py-44">
  <span class="glow-follow" aria-hidden="true"></span>
  <span class="gold-rule absolute inset-x-0 top-0"></span>

  <div class="relative mx-auto w-full max-w-[1100px] px-6 sm:px-10">
    <p
      data-word-scrub
      class="font-serif text-[clamp(1.75rem,4vw,3.4rem)] font-light leading-[1.25] tracking-[-0.01em]"
    >
      {words.map((w, i) => (
        <span class={`scrub-word ${isGold(w) ? 'italic text-gold-light' : ''}`}>{w}{i < words.length - 1 ? ' ' : ''}</span>
      ))}
    </p>

    <div class="mt-12 flex items-center gap-4" data-reveal="rise">
      <span class="h-px w-10 bg-gold/50"></span>
      <span class="eyebrow">Anthony Tamplier — Fondateur</span>
    </div>
  </div>
</section>
