---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Preloader from '../components/Preloader.astro';
import { site, seo } from '../data/content';

interface Props {
  title?: string;
  description?: string;
  showChrome?: boolean; // header + footer
  preload?: boolean;
}
const {
  title = seo.title,
  description = seo.description,
  showChrome = true,
  preload = true,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, site.url).href;
const ogUrl = new URL('/og.jpg', site.url).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'AutoDealer',
  name: site.name,
  description: seo.description,
  url: site.url,
  telephone: site.phoneIntl,
  email: site.email,
  image: ogUrl,
  priceRange: '€€€€',
  founder: { '@type': 'Person', name: site.founder },
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    postalCode: site.address.postalCode,
    addressLocality: site.address.locality,
    addressRegion: site.address.region,
    addressCountry: site.address.country,
  },
  areaServed: [
    { '@type': 'Country', name: 'France' },
    { '@type': 'Place', name: 'Europe' },
  ],
  sameAs: site.socials.map((s) => s.href),
};
---

<!doctype html>
<html lang="fr" data-loading={preload ? '' : undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#ffffff" />

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={seo.ogAlt} />
    <meta property="og:locale" content="fr_FR" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    <link rel="sitemap" href="/sitemap-index.xml" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <noscript>
      <style>
        [data-preloader],
        .cursor-dot,
        .cursor-ring { display: none !important; }
        html { overflow: auto !important; }
      </style>
    </noscript>
  </head>
  <body>
    <a href="#main" class="skip-link">Aller au contenu principal</a>

    {preload && <Preloader />}

    <!-- Custom cursor -->
    <div class="cursor-ring" aria-hidden="true"></div>
    <div class="cursor-dot" aria-hidden="true"></div>

    <!-- Global grain -->
    <div class="grain" aria-hidden="true"></div>

    <span id="top"></span>
    {showChrome && <Header />}

    <main id="main">
      <slot />
    </main>

    {showChrome && <Footer />}

    <script>
      import '../lib/motion.ts';
    </script>
  </body>
</html>
