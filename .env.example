# ————————————————————————————————————————————————
# Réception des demandes du formulaire de contact par e-mail
# ————————————————————————————————————————————————
# Si les deux variables sont vides, le formulaire bascule automatiquement
# sur un fallback mailto: (ouvre le client mail du visiteur).
#
# Option A — Web3Forms (aucune inscription, clé reçue par mail) :
#   PUBLIC_FORM_ENDPOINT=https://api.web3forms.com/submit
#   PUBLIC_FORM_ACCESS_KEY=la-cle-recue-par-mail
#
# Option B — Formspree (compte requis, pas de clé à renseigner ici) :
#   PUBLIC_FORM_ENDPOINT=https://formspree.io/f/xxxxxxxx
#   PUBLIC_FORM_ACCESS_KEY=
#
# Ces variables sont lues AU BUILD : après modification, rebuild + redéploiement,
# et les renseigner aussi côté hébergeur (Vercel/Netlify → Environment Variables).
PUBLIC_FORM_ENDPOINT=
PUBLIC_FORM_ACCESS_KEY=
